# Provider secrets/URLs. These are read by NAME in the instance loader, not as
# Settings fields. An instance is enabled only when its variable(s) are set; the
# pipeline needs at least one SEARCH and one READ provider. Placeholders only —
# never commit real keys.

# --- Search providers (need >= 1) ---
SEARXNG_URL=http://searxng:8080          # SearXNG metasearch base URL
BRAVE_API_KEY=your_brave_key             # optional: Brave Search API subscription token
SERPER_API_KEY=your_serper_key           # optional: Serper Google Search API key
EXA_API_KEY=your_exa_key                 # optional: Exa search API key
# jina-search (s.jina.ai) is also a search provider — it is enabled by
# JINA_API_KEY below (one key, three uses).

# --- Read providers ---
# trafilatura needs no config and is always on (first in the read pipeline).
# JINA_API_KEY enables THREE things at once: the jina reader in keyed mode
# (read pipeline; the reader also works keyless at a lower rate), jina-search
# (s.jina.ai, search pipeline — keyless is blocked there), and the post-merge
# search reranker (jina-reranker-v3.5, see SEARCH_RERANK_ENABLED below).
JINA_API_KEY=your_jina_key               # optional: one Jina key for reader + search + rerank
CRAWL4AI_URL=http://crawl4ai:11235       # optional: self-hosted Crawl4AI base URL
CRAWL4AI_TOKEN=your_crawl4ai_token       # required IF CRAWL4AI_URL is set (Bearer token)
TAVILY_1_API_KEY=your_tavily_key_1       # optional: Tavily Extract key (primary)
TAVILY_2_API_KEY=your_tavily_key_2       # optional: Tavily Extract key (failover)
FIRECRAWL_API_KEY=your_firecrawl_key     # optional: Firecrawl v2 scrape API key

# --- Per-instance proxy (optional) ---
# Route an external instance through a SOCKS5/HTTP proxy (clean egress, e.g. to
# get past Cloudflare IP blocks). Unset → that instance goes direct. Supports
# socks5://host:port (proxy-side DNS), socks5h://..., and http://host:port.
# EXA_PROXY=socks5://internal.lc:1080
# BRAVE_PROXY=socks5://internal.lc:1080
# SERPER_PROXY=socks5://internal.lc:1080
# JINA_PROXY=socks5://internal.lc:1080
# TAVILY_1_PROXY=socks5://internal.lc:1080
# TAVILY_2_PROXY=socks5://internal.lc:1080
# FIRECRAWL_PROXY=socks5://internal.lc:1080

# --- MCP transport (streamable-http; endpoint /mcp). Defaults are fine. ---
MCP_HOST=0.0.0.0
MCP_PORT=8000

# --- Behaviour knobs (defaults are fine). ---
LOG_LEVEL=INFO
LOG_FILE=data/research-mcp.log            # persistent log file (under data/ volume)
LOG_ROTATION=20 MB                        # loguru rotation trigger
LOG_RETENTION=14 days                     # loguru retention window
REQUEST_TIMEOUT=25.0                      # httpx timeout, seconds
FALLBACK_MIN_CHARS=400                    # read content shorter than this → next provider
READ_PAGES_CONCURRENCY=5                  # concurrent reads in read_pages
# Note: the read_pages per-call url cap is a fixed 20 (hard constant in code,
# matching the tool description) — not configurable here.
RETRIES=1                                 # extra retries on transient HTTP failures
SEARCH_RERANK_ENABLED=true                # rerank merged search results (jina-reranker-v3.5;
                                          # needs JINA_API_KEY, silently off without it)
JINA_TOKEN_BUDGET=100000                  # Jina Reader per-request token cap (X-Token-Budget);
                                          # 0 disables the header
